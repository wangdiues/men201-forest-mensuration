# Scratch from preparing the supplementary readings: extracted PDF text and
# page renders used to write the summaries. Not part of the site.
tmp/

# Claude Code session/tool state - not project content.
.claude/
.impeccable/

# Pre-edit snapshots taken before risky changes. Git history is the real
# backup; these are working scratch and can grow very large.
backups/

# Original 4K source video (242MB) - exceeds GitHub's 100MB push limit.
# The site uses the compressed 1080p version (12-web.mp4) instead.
Improvements/Unit 5/12.mp4

# Firebase Admin SDK service account credential - never commit.
serviceAccountKey.json

# Node dependencies (root + functions) and Firebase emulator local state.
node_modules/
firestore-debug.log
ui-debug.log
firebase-debug.log
.firebase/

# API keys - never commit.
Gemini_API_Key.txt
*.key

# Other AI coding tools state
.kilo/

# Cloudflare Worker local build/dev state - not part of the deployed Worker.
cf-relay/.wrangler/

# Real student names and submitted files (FO2025 cohort) - never commit to
# this public repository. Firebase Hosting already excludes this via
# firebase.json, but that doesn't stop a careless `git add` from staging it.
assignments/

# Crash dumps and local generation logs - not project content.
report.*.json
